{
  "name": "securo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api:types": "sh scripts/gen-api-types.sh",
    "api:types:check": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts --default-non-nullable=false && git diff --exit-code -- src/api/openapi.json src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "5.104.1",
    "date-fns": "4.4.0",
    "expo": "57.0.26",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.20",
    "expo-crypto": "57.0.3",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "i18next": "25.10.10",
    "lucide-react-native": "1.50.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "16.6.6",
    "react-native": "0.86.3",
    "react-native-passkey": "3.6.2",
    "react-native-pluggy-connect": "1.6.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
